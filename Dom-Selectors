<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DOM — Selectors</title>
</head>
<body>

  <p id="p1"  class="group-a">Paragraph 1  — group-a</p>
  <p id="p2"  class="group-a">Paragraph 2  — group-a</p>
  <p id="p3"  class="group-a">Paragraph 3  — group-a</p>
  <p id="p4"  class="group-a">Paragraph 4  — group-a</p>
  <p id="p5"  class="group-a">Paragraph 5  — group-a</p>
  <p id="p6"  class="group-b">Paragraph 6  — group-b</p>
  <p id="p7"  class="group-b">Paragraph 7  — group-b</p>
  <p id="p8"  class="group-b">Paragraph 8  — group-b</p>
  <p id="p9"  class="group-b">Paragraph 9  — group-b</p>
  <p id="p10" class="group-b">Paragraph 10 — group-b</p>

  <script>
    const BASE_STYLE = 'padding:10px; margin:6px 0; border-radius:4px; color:white; text-align:justify;';

    // 1. getElementById
    const byId = document.getElementById('p1');
    byId.style.cssText = `${BASE_STYLE} background:navy;`;

    // 2. getElementsByClassName
    const byClass = document.getElementsByClassName('group-b');
    for (const el of byClass) {
      el.style.cssText = `${BASE_STYLE} background:#4a0080;`;
    }

    // 3. getElementsByTagName
    // Logs all <p> elements; styling intentionally skipped to avoid overwriting above.
    const byTag = document.getElementsByTagName('p');
    console.log('getElementsByTagName("p") →', byTag.length, 'elements found');

    // 4. querySelector (first match only)
    const firstMatch = document.querySelector('#p4');
    firstMatch.style.cssText = `${BASE_STYLE} background:darkgreen;`;

    // 5. querySelectorAll
    const selected = document.querySelectorAll('#p2, #p5, #p7');
    for (const el of selected) {
      el.style.cssText = `${BASE_STYLE} background:maroon;`;
    }
  </script>

</body>
</html>
